# Local state. runtime/ itself is source code (the engine host, the catalog and logging modules) and is tracked:
# only the SQLite provider payload that is materialized into it is not committed.
runtime/sqlite-provider/
data/
logs/
backups/
dist/

# Vendored binary payloads are packaged, not committed
vendor/bin/
spikes/**/artifacts/

# Local reports and transient output
*.tmp
*.log
*.bak
Phase1A-Report-*.json

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# PowerShell build/test output
TestResults/
coverage/
